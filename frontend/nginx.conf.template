server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location = /health {
        limit_except GET { deny all; }
        proxy_pass ${API_PROTOCOL}://${API_UPSTREAM}/health;
        proxy_set_header Host $host;
        add_header Cache-Control 'no-store' always;
    }

    # Admin summary endpoint used by the React frontend
    location = /api/admin/summary {
        limit_except GET { deny all; }
        proxy_pass ${API_PROTOCOL}://${API_UPSTREAM}/api/admin/summary;
        proxy_set_header Host $host;
        proxy_set_header X-Admin-Token $http_x_admin_token;
        proxy_connect_timeout 10s;
        proxy_read_timeout 20s;
        add_header Cache-Control 'no-store' always;
    }

    # Ingestion & API endpoints for Windows/Linux collectors and dashboard
    location /api/ {
        proxy_pass ${API_PROTOCOL}://${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Agent-Key $http_x_agent_key;
        proxy_set_header X-Admin-Token $http_x_admin_token;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Legacy dashboard route
    location /dashboard {
        proxy_pass ${API_PROTOCOL}://${API_UPSTREAM}/dashboard;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # Single Page Application
    location / {
        try_files $uri $uri/ /index.html;
    }
}
